generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Document {
  id         String   @id @default(uuid())
  filename   String
  mimeType   String   @default("application/pdf")
  size       Int      @default(0)
  storageKey String   @default("")
  status     String   @default("UPLOADED")
  extractedText String?
  pageCount Int?
  extractedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
   invoice       Invoice?
}

model Invoice {
id                  String   @id @default(uuid())

documentId          String   @unique
document            Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

invoiceNumber       String?
invoiceDate         String?
dueDate             String?

supplierName        String?
supplierTaxId       String?

customerName        String?
customerTaxId       String?

purchaseOrderNumber String?
currency            String?

lineItems           Json

subtotal            Float?
taxRatePercent      Float?
taxAmount           Float?
totalAmount         Float?

paymentTerms        String?
validationPassed    Boolean?
validationDecision  String?
validationIssues    Json?
validatedAt         DateTime?
purchaseOrderMatch  PurchaseOrderMatch?

createdAt           DateTime @default(now())
updatedAt           DateTime @updatedAt
}

model PurchaseOrder {
id              String   @id @default(uuid())
poNumber        String   @unique

supplierName    String
supplierTaxId   String?

buyerName       String
currency        String   @default("INR")

orderDate       DateTime?
expectedTotal   Decimal  @db.Decimal(14, 2)

status          String   @default("OPEN")

lineItems       PurchaseOrderLineItem[]
matches         PurchaseOrderMatch[]

createdAt       DateTime @default(now())
updatedAt       DateTime @updatedAt
}

model PurchaseOrderLineItem {
id                String        @id @default(uuid())

purchaseOrderId   String
purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

description       String
quantity          Decimal       @db.Decimal(14, 3)
unitPrice         Decimal       @db.Decimal(14, 2)
expectedAmount    Decimal       @db.Decimal(14, 2)

createdAt         DateTime      @default(now())
updatedAt         DateTime      @updatedAt

@@index([purchaseOrderId])
}


model PurchaseOrderMatch {
id                String        @id @default(uuid())

invoiceId         String        @unique
invoice           Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

purchaseOrderId   String
purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)

status            String        @default("PENDING")
issues            Json

matchedAt         DateTime?
createdAt         DateTime      @default(now())
updatedAt         DateTime      @updatedAt

@@index([purchaseOrderId])
}





